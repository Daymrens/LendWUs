rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (exists(/databases/$(database)/documents/app_settings/fund_settings) &&
          request.auth.token.email in get(/databases/$(database)/documents/app_settings/fund_settings).data.adminEmails)
        ||
        request.auth.token.email in ['daymrens@gmail.com']
      );
    }

    function isTreasurer() {
      return isAuth() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTreasurer == true)
        ||
        (exists(/databases/$(database)/documents/app_settings/fund_settings) &&
          request.auth.token.email in get(/databases/$(database)/documents/app_settings/fund_settings).data.treasurerEmails)
      );
    }

    function isMemberOf(memberId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId == memberId;
    }

    function isMemberByLinkedEmail(memberId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/members/$(memberId)) &&
        get(/databases/$(database)/documents/members/$(memberId)).data.linkedEmail == request.auth.token.email;
    }

    function canReadMemberData(memberId) {
      return isAuth() && (
        isAdmin() ||
        isMemberOf(memberId) ||
        isMemberByLinkedEmail(memberId)
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ─── users ──────────────────────────────────────────────
    match /users/{userId} {
      allow create: if isAuth() && (isOwner(userId) || isAdmin());
      allow read: if isAuth() && (isOwner(userId) || isAdmin());
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    // ─── members ────────────────────────────────────────────
    match /members/{memberId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAdmin() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'contactNumber'])
        && (isMemberOf(memberId) || isMemberByLinkedEmail(memberId))
      );
      allow delete: if isAdmin();
    }

    // ─── contributions ──────────────────────────────────────
    match /contributions/{contributionId} {
      allow create: if isAdmin();
      allow read: if canReadMemberData(resource.data.memberId);
      allow update, delete: if isAdmin();
    }

    // ─── payment_requests ───────────────────────────────────
    match /payment_requests/{requestId} {
      allow create: if isAuth() && (isMemberOf(request.resource.data.memberId) || isAdmin());
      allow read: if canReadMemberData(resource.data.memberId) || isTreasurer();
      allow update: if isAdmin() || (isTreasurer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankConfirmed', 'bankConfirmedAt', 'bankConfirmedBy']));
      allow delete: if isAdmin();
    }

    // ─── loan_requests ──────────────────────────────────────
    match /loan_requests/{requestId} {
      allow create: if isAuth() && isMemberOf(request.resource.data.memberId);
      allow read: if canReadMemberData(resource.data.memberId);
      allow update, delete: if isAdmin();
    }

    // ─── loan_receipts ──────────────────────────────────────
    match /loan_receipts/{receiptId} {
      allow create: if isAdmin();
      allow read: if isAuth() && (
        isAdmin() ||
        canReadMemberData(resource.data.memberId)
      );
      allow update, delete: if isAdmin();
    }

    // ─── loans ──────────────────────────────────────────────
    match /loans/{loanId} {
      allow create: if isAdmin();
      allow read: if canReadMemberData(resource.data.memberId);
      allow update, delete: if isAdmin();
    }

    // ─── repayments ─────────────────────────────────────────
    match /repayments/{repaymentId} {
      allow create: if isAdmin();
      allow read: if isAuth() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/loans/$(resource.data.loanId)) &&
          canReadMemberData(get(/databases/$(database)/documents/loans/$(resource.data.loanId)).data.memberId))
      );
      allow update, delete: if isAdmin();
    }

    // ─── app_settings ───────────────────────────────────────
    match /app_settings/{settingId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── popups ─────────────────────────────────────────────
    match /popups/{popupId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── head_change_requests ──────────────────────────────
    match /head_change_requests/{requestId} {
      allow create: if isAuth() && isMemberOf(request.resource.data.memberId);
      allow read: if canReadMemberData(resource.data.memberId);
      allow update, delete: if isAdmin();
    }

    // ─── returns ─────────────────────────────────────────────
    match /returns/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── notifications ───────────────────────────────────────
    match /notifications/{notificationId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── user_settings ─────────────────────────────────────────
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── otp_codes ─────────────────────────────────────────────
    match /otp_codes/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── email_logs ─────────────────────────────────────────────
    match /email_logs/{logId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }

    // ─── backups ────────────────────────────────────────────────
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── meta ────────────────────────────────────────────────
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── meta/member_counter ─────────────────────────────────
    match /meta/member_counter {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.resource.data.keys().hasOnly(['lastNumber', 'updatedAt'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber >= 1
        && request.resource.data.lastNumber <= 999999;
    }

    // ─── groups (super admin) ─────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'admin001@lendwus.app';
    }
  }
}