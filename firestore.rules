rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the user's role from Firestore is admin
    function isFirestoreAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the user's email is a hardcoded admin
    function isHardcodedAdmin() {
      return request.auth.token.email == 'act.drapor@gmail.com' || 
             request.auth.token.email == 'daymrens@gmail.com';
    }

    // Helper: check if the user is an admin (either by Firestore role or hardcoded email)
    function isAdmin() {
      return isAuth() && (isFirestoreAdmin() || isHardcodedAdmin());
    }

    // Helper: check if the authenticated user's user doc links to the given memberId
    function isMemberOf(memberId) {
      return isAuth() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId == memberId;
    }

    // Helper: check if the user is the owner of the document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ─── users ──────────────────────────────────────────────
    match /users/{userId} {
      // Users can create their own doc; admins can create docs for any user
      allow create: if isAuth() && (isOwner(userId) || isAdmin());
      // Users can read/update their own doc; admins can read/update all
      allow read, update: if isAuth() && (isOwner(userId) || isAdmin());
      // Only admins can delete or list users
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    // ─── members ────────────────────────────────────────────
    match /members/{memberId} {
      // Any authenticated user can create a member (self-signup via group code)
      allow create: if isAuth();
      allow read: if isAuth();
      // Admins can update or delete members
      allow update, delete: if isAdmin();
    }

    // ─── contributions ──────────────────────────────────────
    match /contributions/{contributionId} {
      // Admins can create; done via payment request approval or manually
      allow create: if isAdmin();
      // Members can read their own; admins can read all
      allow read: if isAuth() && (isMemberOf(resource.data.memberId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── payment_requests ───────────────────────────────────
    match /payment_requests/{requestId} {
      // Members can create their own payment requests
      allow create: if isAuth() && isMemberOf(request.resource.data.memberId);
      // Members can read their own; admins can read all
      allow read: if isAuth() && (isMemberOf(resource.data.memberId) || isAdmin());
      // Only admins can update (approve/reject) or delete
      allow update, delete: if isAdmin();
    }

    // ─── loan_requests ──────────────────────────────────────
    match /loan_requests/{requestId} {
      // Members can create their own loan requests
      allow create: if isAuth() && isMemberOf(request.resource.data.memberId);
      // Members can read their own; admins can read all
      allow read: if isAuth() && (isMemberOf(resource.data.memberId) || isAdmin());
      // Only admins can update (approve/reject) or delete
      allow update, delete: if isAdmin();
    }

    // ─── loans ──────────────────────────────────────────────
    match /loans/{loanId} {
      // Only admins can create loans (done via loan request approval)
      allow create: if isAdmin();
      // Members can read their own loans; admins can read all
      allow read: if isAuth() && (isMemberOf(resource.data.memberId) || isAdmin());
      // Only admins can update or delete loans
      allow update, delete: if isAdmin();
    }

    // ─── repayments ─────────────────────────────────────────
    match /repayments/{repaymentId} {
      // Only admins can create repayments
      allow create: if isAdmin();
      // Members can read repayments on their own loans; admins can read all
      allow read: if isAuth() && (isAdmin() || (exists(/databases/$(database)/documents/loans/$(resource.data.loanId)) && isMemberOf(get(/databases/$(database)/documents/loans/$(resource.data.loanId)).data.memberId)));
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // ─── app_settings ───────────────────────────────────────
    match /app_settings/{settingId} {
      // Any authenticated user can read app settings
      allow read: if isAuth();
      // Only admins can write app settings
      allow create, update, delete: if isAdmin();
    }

    // ─── head_change_requests ─────────────────────────────────
    match /head_change_requests/{requestId} {
      // Members can create their own head change requests
      allow create: if isAuth() && isMemberOf(request.resource.data.memberId);
      // Members can read their own; admins can read all
      allow read: if isAuth() && (isMemberOf(resource.data.memberId) || isAdmin());
      // Only admins can update (approve/reject) or delete
      allow update, delete: if isAdmin();
    }

    // ─── returns ─────────────────────────────────────────────
    match /returns/{docId} {
      // Any authenticated user can read returns info
      allow read: if isAuth();
      // Only admins can write returns info
      allow create, update, delete: if isAdmin();
    }
  }
}
